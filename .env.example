NODE_ENV=development
HOST=127.0.0.1
PORT=4174
APP_ORIGIN=http://127.0.0.1:4174
DATABASE_URL=postgresql://arviva_website:CHANGE_ME@127.0.0.1:5432/arviva_website_dev
TEST_DATABASE_URL=postgresql://arviva_website:CHANGE_ME@127.0.0.1:5432/arviva_website_test
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# disabled: no login emails; development: local private files, no emails; smtp: real delivery
MAIL_MODE=disabled
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# QQ Mail: full email address; password below is the SMTP authorization code.
SMTP_USER=
SMTP_PASSWORD=
# Use the same QQ email address as SMTP_USER.
SMTP_FROM=
# disabled: no SMS; development: private local files only; aliyun-pnvs: real billable SMS.
# Development delivery is allowed only in nonproduction with loopback HOST and APP_ORIGIN.
SMS_MODE=disabled
# Global server-side daily request budget; lower it before enabling real SMS as needed.
SMS_DAILY_LIMIT=100
# Alibaba Cloud Phone Number Verification Service (PNVS), NOT the separate SMS/Dysmsapi product.
# Enable PNVS SMS authentication and use its console-provided signature/template.
# The selected template must accept the code and min variables; codes are verified locally.
# Grant the RAM identity dypns:SendSmsVerifyCode; keep credentials only in the private server env.
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# Optional, up to 20 characters; blank uses the provider's default scheme.
ALIYUN_SMS_SCHEME_NAME=
# Only enable loopback when local Nginx overwrites X-Real-IP with $remote_addr.
TRUST_PROXY=none
