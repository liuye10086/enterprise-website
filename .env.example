NODE_ENV=development
HOST=127.0.0.1
PORT=4174
APP_ORIGIN=http://127.0.0.1:4174
DATABASE_URL=postgresql://arviva_website:CHANGE_ME@127.0.0.1:5432/arviva_website_dev
TEST_DATABASE_URL=postgresql://arviva_website:CHANGE_ME@127.0.0.1:5432/arviva_website_test
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# disabled: no login emails; development: local private files, no emails; smtp: real delivery
MAIL_MODE=disabled
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# QQ Mail: full email address; password below is the SMTP authorization code.
SMTP_USER=
SMTP_PASSWORD=
# Use the same QQ email address as SMTP_USER.
SMTP_FROM=
# Only enable loopback when local Nginx overwrites X-Real-IP with $remote_addr.
TRUST_PROXY=none
