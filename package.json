{
  "name": "arviva-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Arviva Therapeutics website with PostgreSQL email authentication",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node scripts/build.mjs && node --env-file-if-exists=.env --test tests/*.test.mjs",
    "test:auth": "node --env-file=.env --test tests/auth.integration.test.mjs tests/auth-http.test.mjs tests/auth-config.test.mjs tests/access-live.test.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:setup:local": "node --env-file=tmp/postgresql-admin.env scripts/setup-local-db.mjs",
    "start": "node --env-file=.env scripts/start.mjs"
  },
  "dependencies": {
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1"
  }
}
